# Everything here is optional — Gnosis runs with these defaults.
# Only needed when running Gnosis directly on your machine (not via `docker compose up`).

# Postgres + pgvector connection string.
# Default matches the database started by `docker compose up db` (host port 5433).
# To use Supabase instead: Dashboard → Project Settings → Database → Connection string → URI
# (direct connection, port 5432 — not the pooler).
DATABASE_URL=postgresql://postgres:gnosis@localhost:5433/postgres

# Local LLM for HyDE query expansion and summarize_topic.
# Defaults to Ollama on localhost. Also works with LM Studio (http://localhost:1234).
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
